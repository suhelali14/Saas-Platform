# Dependencies
node_modules/

# Build outputs
dist/
# nayaverse-web builds a server bundle to prerender its routes; it is an
# intermediate, not an artifact.
dist-ssr/
build/
.next/
.turbo/

# Expo
.expo/
.expo-shared/
ios/
android/

# Env
.env
.env.local
.env.*.local

# MCP config -- kept out of git since it's ended up holding a raw token
# directly rather than an env-var reference; see .mcp.json.example.
.mcp.json

# Prisma
apps/api/prisma/dev.db*

# Generated Prisma client (custom output path, includes a platform-specific
# binary engine) -- regenerated by `prisma generate`, never committed.
apps/clinic-api/src/generated/

# Uploaded KYC documents (PAN cards, cancelled cheques, GST certificates) --
# never committed, local-disk storage only (see apps/api/src/lib/file-storage.ts).
apps/api/uploads/

# Clinic case-sheet attachments (X-rays, lab reports) -- patient health data,
# never committed, local-disk storage only (see apps/clinic-api/src/lib/file-storage.ts).
apps/clinic-api/uploads/

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/*
!.vscode/extensions.json

# Vercel CLI link state -- contains project/org ids.
.vercel

# TypeScript's incremental cache. Two of these were committed, so every
# checkout went dirty the moment anyone ran a typecheck -- and a cache
# keyed to one machine's absolute paths is never useful on another.
*.tsbuildinfo

# ── Local agent tooling ─────────────────────────────────────────────────
# Claude Code's project-local state: settings, skills, hooks and plan
# files. Machine-specific (the skill scripts carry absolute Windows paths
# and a downloaded per-platform binary), so a committed copy is wrong on
# any other checkout and goes stale on this one.
.claude/
.github/agents/
.github/hooks/
.github/skills/

# Agent scratch space.
.plans/
*.orig
*.rej

# Caches that are rebuilt on demand and keyed to one machine.
.cache/
.eslintcache
.vite/
coverage/
*.tmp

# Python bytecode from the repo's check scripts in scripts/.
__pycache__/
*.pyc

# ── Private product and business records ────────────────────────────────
# This repository is PUBLIC. These two hold things that should not be:
#
#   PRODUCT.md  names the one live customer and the doctor at it, states
#               that nothing else is lined up, and lists what is not built.
#   founder/    the board review, the risk analysis, infrastructure costs
#               and the undecided price.
#
# Both stay on disk, so the Impeccable and founder skills still read them
# normally -- they are simply not published. Keep a backup outside the
# working tree: being untracked means `git clean -fdx` would delete them.
PRODUCT.md
founder/
