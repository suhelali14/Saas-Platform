{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "git": {
    "deploymentEnabled": {
      "master": false,
      "main": false
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.nayaverse.in" }],
      "destination": "https://www.nayaversse.in/:path*",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "nayaverse.in" }],
      "destination": "https://nayaversse.in/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/pricing",
      "destination": "/pricing.html"
    },
    {
      "source": "/hi",
      "destination": "/hi.html"
    },
    {
      "source": "/hi/pricing",
      "destination": "/hi/pricing.html"
    },
    {
      "source": "/mr",
      "destination": "/mr.html"
    },
    {
      "source": "/mr/pricing",
      "destination": "/mr/pricing.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
