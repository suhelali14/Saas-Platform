    },
    {
      "source": "/mr/about",
      "destination": "/mr/about.html"
    },
    {
      "source": "/mr/features",
      "destination": "/mr/features.html"
    },
    {
      "source": "/mr/security",
      "destination": "/mr/security.html"
    },
    {
      "source": "/mr/why-nayaversse",
