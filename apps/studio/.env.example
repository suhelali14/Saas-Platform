# The brains. Ideation, scripting and the per-language copy all go through
# this. Without it `daily` cannot run; everything else still works.
ANTHROPIC_API_KEY=

# Model names churn faster than this code will. The default is the small
# fast one on purpose: this writes six captions a day, not essays.
STUDIO_MODEL=claude-haiku-5-5

# Where drafts and renders land. Gitignored.
STUDIO_DIR=content

# One token per account, as JSON, because three accounts means three
# tokens and a flat list of variables gets miswired.
#
# Each account must be an Instagram PROFESSIONAL account, and the Facebook
# Page behind it must have completed Page Publishing Authorization or
# publishing is refused with an error that does not mention PPA.
#
# Permissions needed: instagram_business_basic + instagram_business_content_publish
# STUDIO_INSTAGRAM={"nayaverse":{"igUserId":"1784...","token":"EAA..."},"clinics":{"igUserId":"...","token":"..."}}
STUDIO_INSTAGRAM=

# Publish with nobody reading it first. Leave false.
#
# Not a technical setting. Nayaverse is B2B software, so India's medical
# advertising rules bind a doctor rather than a vendor -- until an account
# posts something a reader takes as health guidance, when the Drugs and
# Magic Remedies Act and the ASCI code apply to it. And the NMC prohibits a
# practitioner from soliciting patients or sharing testimonials, so a reel
# naming a real clinic risks THAT DOCTOR'S registration, not this brand's
# reputation. A person reading a draft for thirty seconds removes the whole
# category. The rules in lib/guard.ts are a floor, not a substitute.
STUDIO_AUTOPUBLISH=false
