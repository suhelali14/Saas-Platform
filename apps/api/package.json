{
  "name": "@intently/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "eval:intent": "tsx src/services/eval-intent.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/multipart": "^10.1.1",
    "@google/genai": "^2.18.0",
    "@intently/shared-types": "*",
    "@octokit/rest": "^22.0.1",
    "@prisma/client": "^6.1.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.0",
    "expo-server-sdk": "^7.2.0",
    "fastify": "^5.1.0",
    "fastify-plugin": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "razorpay": "^2.9.8",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.0",
    "prisma": "^6.1.0",
    "tsx": "^4.19.0",
    "typescript": "^6.0.0"
  }
}
