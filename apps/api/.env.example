# Server
PORT=4000
NODE_ENV=development

# Database — run `docker compose up -d` at the repo root (Postgres + pgvector),
# or point this at a hosted Postgres instance (Neon, Supabase, RDS, ...).
DATABASE_URL="postgresql://intently:intently@localhost:5432/intently"

# AI provider(s) — power the Intent Understanding Agent (docs/04-multi-agent-design.md,
# docs/10-tech-stack-decisions.md "Multi-provider AI layer"). Set either or
# both keys; src/services/ai/provider-selector.ts picks whichever is
# configured, and src/services/intent-service.ts falls back to a heuristic
# parser if neither is set (also the fallback if a live call fails).
# AI_PROVIDER forces a specific one instead of the "whichever is
# configured, Anthropic first" default -- values: auto | anthropic | gemini
AI_PROVIDER=auto

# Defaults to claude-opus-5; docs/10's cost-tiering plan (a cheaper model
# for routine parsing) is a deliberate opt-in via ANTHROPIC_MODEL, not a default.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Signs session JWTs issued by POST /api/auth/anonymous (docs/14-mvp-implementation-plan.md M5).
# Generate a real value for anything beyond local dev, e.g.: openssl rand -hex 32
JWT_SECRET=dev-only-change-me-before-anything-beyond-local-use
