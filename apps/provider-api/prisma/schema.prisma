// Provider console — the VENDOR's own database.
//
// This is not a clinic's database and must never become one. It holds the
// registry of clinics sold to, their plans, their deal terms and their
// deployment metadata. It holds no patient data of any kind.
//
// The hard rule, encoded below: **no clinic database credential is ever
// stored here.** Provisioning needs one, but it is fetched from Neon at the
// moment of use and discarded. What is stored is `neonProjectId` — a
// reference, useless on its own. A breach of this console is therefore one
// API key to rotate, not every clinic's PHI at once, which under the DPDP
// Act is the difference between an incident and a catastrophe.

generator client {
  provider = "prisma-client-js"
  // Own output path, same reasoning as clinic-api: three schemas in this
  // monorepo would otherwise fight over the hoisted @prisma/client.
  output   = "../src/generated/prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Who can sign in to the console. This is the vendor's own team.
model ProviderUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         ProviderRole @default(OWNER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  activity ActivityLog[]
}

enum ProviderRole {
  OWNER
  STAFF
}

enum AccountStatus {
  LEAD          // in conversation, nothing built
  ONBOARDING    // provisioning in progress
  LIVE          // serving patients
  SUSPENDED     // non-payment or at the clinic's request
  CHURNED
}

enum PlanTier {
  BASIC
  STANDARD
  PREMIUM
  ENTERPRISE
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  ANNUAL
}

/// How a clinic pays. See src/lib/billing.ts.
enum PricingModel {
  SETUP_YEARLY // one-time setup fee + yearly service fee (the default)
  SUBSCRIPTION // monthly fee, billed by the billing cycle
  LICENCE_AMC  // one-time licence, then yearly maintenance + hosting
}

enum InvoiceStatus {
  DRAFT  // being prepared; no number yet
  ISSUED // numbered and sent; a GST invoice from here on
  PAID
  VOID   // cancelled after issue; kept, because the number was used
}

/// One clinic customer.
model ClinicAccount {
  id        String @id @default(cuid())
  /// URL-safe identifier used for generated subdomains and project names.
  slug      String @unique
  name      String

  // Who to call when something breaks.
  contactName  String?
  contactEmail String?
  contactPhone String?
  city         String?
  notes        String?

  status AccountStatus @default(LEAD)
  plan   PlanTier      @default(BASIC)

  /// Features granted beyond the plan, for a deal that includes something
  /// off-tier. Merged over the plan's defaults when the .env is generated,
  /// so a one-off promise made in a sales call survives as configuration
  /// rather than as a note nobody reads.
  featureOverrides Json?

  // ── Deal terms ────────────────────────────────────────────────────────
  monthlyFee   Decimal?     @db.Decimal(10, 2)
  currency     String       @default("INR")
  billingCycle BillingCycle @default(MONTHLY)
  startedAt    DateTime?
  renewsAt     DateTime?

  // ── The deal ─────────────────────────────────────────────────────────
  // What this clinic actually pays; the plan's list price is only where a
  // deal starts. See src/lib/billing.ts for how each model is invoiced.
  pricingModel PricingModel @default(SETUP_YEARLY)
  setupFee     Decimal?     @db.Decimal(12, 2)
  yearlyFee    Decimal?     @db.Decimal(12, 2)
  licenceFee   Decimal?     @db.Decimal(12, 2)
  amcPercent   Decimal?     @db.Decimal(5, 2)
  hostingFee   Decimal?     @db.Decimal(12, 2)
  /// Extra or fewer logins than the plan, agreed in the deal. 0 = unlimited.
  maxUsersOverride Int?

  // ── Who the invoice is made out to ───────────────────────────────────
  billingName    String?
  billingAddress String?
  /// The clinic's GSTIN, if registered. Decides the place of supply.
  gstin          String?
  /// Two-digit GST state code. From the GSTIN when there is one.
  billingState   String?

  // ── What the clinic's server was last told ───────────────────────────
  // So the console can say "the clinic is running X; you have changed it
  // to Y and not applied it" instead of assuming an edit took effect.
  appliedPlan     PlanTier?
  appliedFeatures String?
  appliedReadOnly Boolean?
  appliedAt       DateTime?
  planJobId       String?

  /// A demonstration deployment: made-up patients, reset nightly.
  isDemo Boolean @default(false)

  // ── Deployment ────────────────────────────────────────────────────────
  publicDomain String?   // drasif.in
  portalDomain String?   // dashboard.drasif.in
  apiDomain    String?   // api.drasif.in

  /// Neon project reference. NOT a credential — the connection string is
  /// fetched from Neon at the moment it is needed and never written here.
  neonProjectId String?
  /// Vercel project ids, so a redeploy can find them again.
  vercelWebProjectId String?
  vercelApiProjectId String?

  /// True once the provisioning run has completed end to end.
  provisionedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  steps       OnboardingStep[]
  activity    ActivityLog[]
  health      HealthCheck[]
  invoices    Invoice[]
  planChanges PlanChange[]

  @@index([status])
}

/// The onboarding checklist for one clinic. Rows are created from a fixed
/// template when the account is created, so progress is visible rather than
/// living in someone's head.
model OnboardingStep {
  id        String  @id @default(cuid())
  accountId String
  account   ClinicAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  key       String
  label     String
  /// Whether the console performs this step or a human does. Shown in the
  /// UI so nobody waits on a button that was never going to exist.
  automated Boolean @default(false)
  sortOrder Int     @default(0)

  done   Boolean   @default(false)
  doneAt DateTime?
  notes  String?

  @@unique([accountId, key])
  @@index([accountId, sortOrder])
}

/// Append-only record of what was done to an account and by whom. The same
/// reasoning as the clinic's own audit log: an action on a customer's
/// infrastructure should be attributable months later.
model ActivityLog {
  id        String   @id @default(cuid())
  accountId String?
  account   ClinicAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  actorId   String?
  actor     ProviderUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  /// Denormalized so the entry still reads after a team member leaves.
  actorName String

  action  String
  detail  String?
  /// False when the action ran in dry-run mode, so a rehearsal is never
  /// mistaken for the real thing when reading the history back.
  applied Boolean @default(true)

  at DateTime @default(now())

  @@index([accountId, at])
  @@index([at])
}

/// Result of pinging a clinic's /health endpoint. Deliberately the only
/// thing this console ever reads from a live clinic deployment — no patient
/// data, no counts, nothing behind auth.
model HealthCheck {
  id        String   @id @default(cuid())
  accountId String
  account   ClinicAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  ok         Boolean
  statusCode Int?
  latencyMs  Int?
  error      String?
  checkedAt  DateTime @default(now())

  @@index([accountId, checkedAt])
}

/// One of Nayaverse's own invoices to a clinic. A GST tax invoice once it
/// is ISSUED: from then on its lines and number are never edited, only
/// marked paid or voided -- an invoice that changes after it was sent is
/// not an invoice.
model Invoice {
  id        String        @id @default(cuid())
  accountId String
  account   ClinicAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  /// PREFIX/FY/0001. Null while a draft; given on issue, consecutive
  /// within the financial year, as GST requires.
  number    String?       @unique
  fy        String?
  serial    Int?
  status    InvoiceStatus @default(DRAFT)

  issuedAt    DateTime?
  dueAt       DateTime?
  periodStart DateTime?
  /// True for the invoice that starts the contract (carries setup/licence).
  isFirst     Boolean       @default(false)

  // Copied at creation, so a later edit to the account does not rewrite
  // an invoice already sent.
  billingName    String?
  billingAddress String?
  gstin          String?
  placeOfSupply  String?
  planLabel      String

  /// [{ description, sac, amount }]
  lines    Json
  subtotal Decimal @db.Decimal(12, 2)
  cgst     Decimal @db.Decimal(12, 2)
  sgst     Decimal @db.Decimal(12, 2)
  igst     Decimal @db.Decimal(12, 2)
  total    Decimal @db.Decimal(12, 2)

  paidAt      DateTime?
  paymentMode String?
  paymentRef  String?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fy, serial])
  @@index([accountId, createdAt])
  @@index([status, dueAt])
}

/// Every change to what a clinic is entitled to, and whether it reached
/// the clinic. The answer to "when did they move to Hospital, and who
/// agreed it" a year later.
model PlanChange {
  id        String        @id @default(cuid())
  accountId String
  account   ClinicAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  fromPlan     PlanTier?
  toPlan       PlanTier
  fromFeatures String?
  toFeatures   String
  readOnly     Boolean @default(false)
  reason       String?
  actorName    String
  jobId        String?

  at DateTime @default(now())

  @@index([accountId, at])
}
