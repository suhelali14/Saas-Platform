// Provider console — the VENDOR's own database.
//
// This is not a clinic's database and must never become one. It holds the
// registry of clinics sold to, their plans, their deal terms and their
// deployment metadata. It holds no patient data of any kind.
//
// The hard rule, encoded below: **no clinic database credential is ever
// stored here.** Provisioning needs one, but it is fetched from Neon at the
// moment of use and discarded. What is stored is `neonProjectId` — a
// reference, useless on its own. A breach of this console is therefore one
// API key to rotate, not every clinic's PHI at once, which under the DPDP
// Act is the difference between an incident and a catastrophe.

generator client {
  provider = "prisma-client-js"
  // Own output path, same reasoning as clinic-api: three schemas in this
  // monorepo would otherwise fight over the hoisted @prisma/client.
  output   = "../src/generated/prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Who can sign in to the console. This is the vendor's own team.
model ProviderUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         ProviderRole @default(OWNER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  activity ActivityLog[]
}

enum ProviderRole {
  OWNER
  STAFF
}

enum AccountStatus {
  LEAD          // in conversation, nothing built
  ONBOARDING    // provisioning in progress
  LIVE          // serving patients
  SUSPENDED     // non-payment or at the clinic's request
  CHURNED
}

enum PlanTier {
  BASIC
  STANDARD
  PREMIUM
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  ANNUAL
}

/// One clinic customer.
model ClinicAccount {
  id        String @id @default(cuid())
  /// URL-safe identifier used for generated subdomains and project names.
  slug      String @unique
  name      String

  // Who to call when something breaks.
  contactName  String?
  contactEmail String?
  contactPhone String?
  city         String?
  notes        String?

  status AccountStatus @default(LEAD)
  plan   PlanTier      @default(BASIC)

  /// Features granted beyond the plan, for a deal that includes something
  /// off-tier. Merged over the plan's defaults when the .env is generated,
  /// so a one-off promise made in a sales call survives as configuration
  /// rather than as a note nobody reads.
  featureOverrides Json?

  // ── Deal terms ────────────────────────────────────────────────────────
  monthlyFee   Decimal?     @db.Decimal(10, 2)
  currency     String       @default("INR")
  billingCycle BillingCycle @default(MONTHLY)
  startedAt    DateTime?
  renewsAt     DateTime?

  // ── Deployment ────────────────────────────────────────────────────────
  publicDomain String?   // drasif.in
  portalDomain String?   // dashboard.drasif.in
  apiDomain    String?   // api.drasif.in

  /// Neon project reference. NOT a credential — the connection string is
  /// fetched from Neon at the moment it is needed and never written here.
  neonProjectId String?
  /// Vercel project ids, so a redeploy can find them again.
  vercelWebProjectId String?
  vercelApiProjectId String?

  /// True once the provisioning run has completed end to end.
  provisionedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  steps    OnboardingStep[]
  activity ActivityLog[]
  health   HealthCheck[]

  @@index([status])
}

/// The onboarding checklist for one clinic. Rows are created from a fixed
/// template when the account is created, so progress is visible rather than
/// living in someone's head.
model OnboardingStep {
  id        String  @id @default(cuid())
  accountId String
  account   ClinicAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  key       String
  label     String
  /// Whether the console performs this step or a human does. Shown in the
  /// UI so nobody waits on a button that was never going to exist.
  automated Boolean @default(false)
  sortOrder Int     @default(0)

  done   Boolean   @default(false)
  doneAt DateTime?
  notes  String?

  @@unique([accountId, key])
  @@index([accountId, sortOrder])
}

/// Append-only record of what was done to an account and by whom. The same
/// reasoning as the clinic's own audit log: an action on a customer's
/// infrastructure should be attributable months later.
model ActivityLog {
  id        String   @id @default(cuid())
  accountId String?
  account   ClinicAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  actorId   String?
  actor     ProviderUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  /// Denormalized so the entry still reads after a team member leaves.
  actorName String

  action  String
  detail  String?
  /// False when the action ran in dry-run mode, so a rehearsal is never
  /// mistaken for the real thing when reading the history back.
  applied Boolean @default(true)

  at DateTime @default(now())

  @@index([accountId, at])
  @@index([at])
}

/// Result of pinging a clinic's /health endpoint. Deliberately the only
/// thing this console ever reads from a live clinic deployment — no patient
/// data, no counts, nothing behind auth.
model HealthCheck {
  id        String   @id @default(cuid())
  accountId String
  account   ClinicAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  ok         Boolean
  statusCode Int?
  latencyMs  Int?
  error      String?
  checkedAt  DateTime @default(now())

  @@index([accountId, checkedAt])
}
