// Provider console — the VENDOR's own database.
//
// This is not a clinic's database and must never become one. It holds the
// registry of clinics sold to, their plans, their deal terms and their
// deployment metadata. It holds no patient data of any kind.
//
// The hard rule, encoded below: **no clinic database credential is ever
// stored here.** Provisioning needs one, but it is fetched from Neon at the
// moment of use and discarded. What is stored is `neonProjectId` — a
// reference, useless on its own. A breach of this console is therefore one
// API key to rotate, not every clinic's PHI at once, which under the DPDP
// Act is the difference between an incident and a catastrophe.

generator client {
  provider = "prisma-client-js"
  // Own output path, same reasoning as clinic-api: three schemas in this
  // monorepo would otherwise fight over the hoisted @prisma/client.
  output   = "../src/generated/prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Who can sign in to the console. This is the vendor's own team.
model ProviderUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         ProviderRole @default(OWNER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  activity ActivityLog[]
}

enum ProviderRole {
  OWNER
  STAFF
}

enum AccountStatus {
  LEAD          // in conversation, nothing built
  ONBOARDING    // provisioning in progress
  LIVE          // serving patients
  SUSPENDED     // non-payment or at the clinic's request
  CHURNED
}

enum PlanTier {
  BASIC
  STANDARD
  PREMIUM
  ENTERPRISE
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  ANNUAL
}

/// How a clinic pays. See src/lib/billing.ts.
enum PricingModel {
  SETUP_YEARLY // one-time setup fee + yearly service fee (the default)
  SUBSCRIPTION // monthly fee, billed by the billing cycle
  LICENCE_AMC  // one-time licence, then yearly maintenance + hosting
}

enum InvoiceStatus {
  DRAFT  // being prepared; no number yet
  ISSUED // numbered and sent; a GST invoice from here on
  PAID
  VOID   // cancelled after issue; kept, because the number was used
}

/// Where a quotation lives in its own lifecycle. Separate from
/// Invoice/Agreement because the same deal moves through all three in
/// order: quote → accept → agreement → invoice.
enum QuotationStatus {
  DRAFT    // being written, numbers still moving
  SENT     // locked, delivered to the client
  ACCEPTED // the client agreed in writing or by email
  REJECTED // the client said no, kept so the history is readable
  EXPIRED  // valid-until date has passed with no response
}

enum QuotationLineCategory {
  SOFTWARE       // the annual or monthly licence itself
  IMPLEMENTATION // one-time: provisioning, setup, go-live
  TRAINING       // one-time: staff training on the software
  CUSTOMIZATION  // one-time: specialty forms, custom reports, white-labelling
  DATA_MIGRATION // one-time: import of existing records
  SUPPORT        // annual: priority / dedicated support, SLA
  HARDWARE       // one-time: the odd time a clinic asks us to source a printer
  OTHER
}

enum AgreementStatus {
  DRAFT          // being written
  AWAITING_SIGN  // issued, waiting for the client to sign
  ACTIVE         // both parties signed; the contract is in force
  TERMINATED     // ended before its natural term
  EXPIRED        // ran to the end of its term and was not renewed
}

/// The sales pipeline the owner opens each morning. Separate from
/// QuotationStatus because a quote can be SENT and still at NEGOTIATION,
/// and the morning view wants the deal not the paper.
enum PipelineStage {
  NEW_LEAD         // first contact; a name, maybe an email
  QUALIFIED        // confirmed interest, confirmed budget shape
  QUOTE_SENT       // a Quotation exists and the client has it
  FOLLOW_UP        // sent, chased once, waiting on a reply
  NEGOTIATION      // actively going back and forth on terms or price
  CLOSED_WON       // accepted; the agreement is the next document
  CLOSED_LOST      // the client went elsewhere, or disappeared
}

/// A kind of touch on a deal. One row per real contact so the funnel
/// view answers "when did we last talk to this clinic" without a guess.
enum ActivityKind {
  CALL
  EMAIL_SENT
  EMAIL_RECEIVED
  MEETING
  WHATSAPP
  SITE_VISIT
  NOTE
}

/// One clinic customer.
model ClinicAccount {
  id        String @id @default(cuid())
  /// URL-safe identifier used for generated subdomains and project names.
  slug      String @unique
  name      String

  // Who to call when something breaks.
  contactName  String?
  contactEmail String?
  contactPhone String?
  city         String?
  notes        String?

  status AccountStatus @default(LEAD)
  plan   PlanTier      @default(BASIC)

  /// Features granted beyond the plan, for a deal that includes something
  /// off-tier. Merged over the plan's defaults when the .env is generated,
  /// so a one-off promise made in a sales call survives as configuration
  /// rather than as a note nobody reads.
  featureOverrides Json?

  // ── Deal terms ────────────────────────────────────────────────────────
  monthlyFee   Decimal?     @db.Decimal(10, 2)
  currency     String       @default("INR")
  billingCycle BillingCycle @default(MONTHLY)
  startedAt    DateTime?
  renewsAt     DateTime?

  // ── The deal ─────────────────────────────────────────────────────────
  // What this clinic actually pays; the plan's list price is only where a
  // deal starts. See src/lib/billing.ts for how each model is invoiced.
  pricingModel PricingModel @default(SETUP_YEARLY)
  setupFee     Decimal?     @db.Decimal(12, 2)
  yearlyFee    Decimal?     @db.Decimal(12, 2)
  licenceFee   Decimal?     @db.Decimal(12, 2)
  amcPercent   Decimal?     @db.Decimal(5, 2)
  hostingFee   Decimal?     @db.Decimal(12, 2)
  /// Extra or fewer logins than the plan, agreed in the deal. 0 = unlimited.
  maxUsersOverride Int?

  // ── Who the invoice is made out to ───────────────────────────────────
  billingName    String?
  billingAddress String?
  /// The clinic's GSTIN, if registered. Decides the place of supply.
  gstin          String?
  /// Two-digit GST state code. From the GSTIN when there is one.
  billingState   String?

  // ── What the clinic's server was last told ───────────────────────────
  // So the console can say "the clinic is running X; you have changed it
  // to Y and not applied it" instead of assuming an edit took effect.
  appliedPlan     PlanTier?
  appliedFeatures String?
  appliedReadOnly Boolean?
  appliedAt       DateTime?
  planJobId       String?

  /// A demonstration deployment: made-up patients, reset nightly.
  isDemo Boolean @default(false)

  // ── Deployment ────────────────────────────────────────────────────────
  publicDomain String?   // drasif.in
  portalDomain String?   // dashboard.drasif.in
  apiDomain    String?   // api.drasif.in

  /// Neon project reference. NOT a credential — the connection string is
  /// fetched from Neon at the moment it is needed and never written here.
  neonProjectId String?
  /// Vercel project ids, so a redeploy can find them again.
  vercelWebProjectId String?
  vercelApiProjectId String?

  /// True once the provisioning run has completed end to end.
  provisionedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  steps       OnboardingStep[]
  activity    ActivityLog[]
  health      HealthCheck[]
  invoices    Invoice[]
  planChanges PlanChange[]
  quotations  Quotation[]
  agreements  Agreement[]

  @@index([status])
}

/// The onboarding checklist for one clinic. Rows are created from a fixed
/// template when the account is created, so progress is visible rather than
/// living in someone's head.
model OnboardingStep {
  id        String  @id @default(cuid())
  accountId String
  account   ClinicAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  key       String
  label     String
  /// Whether the console performs this step or a human does. Shown in the
  /// UI so nobody waits on a button that was never going to exist.
  automated Boolean @default(false)
  sortOrder Int     @default(0)

  done   Boolean   @default(false)
  doneAt DateTime?
  notes  String?

  @@unique([accountId, key])
  @@index([accountId, sortOrder])
}

/// Append-only record of what was done to an account and by whom. The same
/// reasoning as the clinic's own audit log: an action on a customer's
/// infrastructure should be attributable months later.
model ActivityLog {
  id        String   @id @default(cuid())
  accountId String?
  account   ClinicAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  actorId   String?
  actor     ProviderUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  /// Denormalized so the entry still reads after a team member leaves.
  actorName String

  action  String
  detail  String?
  /// False when the action ran in dry-run mode, so a rehearsal is never
  /// mistaken for the real thing when reading the history back.
  applied Boolean @default(true)

  at DateTime @default(now())

  @@index([accountId, at])
  @@index([at])
}

/// Result of pinging a clinic's /health endpoint. Deliberately the only
/// thing this console ever reads from a live clinic deployment — no patient
/// data, no counts, nothing behind auth.
model HealthCheck {
  id        String   @id @default(cuid())
  accountId String
  account   ClinicAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  ok         Boolean
  statusCode Int?
  latencyMs  Int?
  error      String?
  checkedAt  DateTime @default(now())

  @@index([accountId, checkedAt])
}

/// One of Nayaverse's own invoices to a clinic. A GST tax invoice once it
/// is ISSUED: from then on its lines and number are never edited, only
/// marked paid or voided -- an invoice that changes after it was sent is
/// not an invoice.
model Invoice {
  id        String        @id @default(cuid())
  accountId String
  account   ClinicAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  /// PREFIX/FY/0001. Null while a draft; given on issue, consecutive
  /// within the financial year, as GST requires.
  number    String?       @unique
  fy        String?
  serial    Int?
  status    InvoiceStatus @default(DRAFT)

  issuedAt    DateTime?
  dueAt       DateTime?
  periodStart DateTime?
  /// True for the invoice that starts the contract (carries setup/licence).
  isFirst     Boolean       @default(false)

  // Copied at creation, so a later edit to the account does not rewrite
  // an invoice already sent.
  billingName    String?
  billingAddress String?
  gstin          String?
  placeOfSupply  String?
  planLabel      String

  /// [{ description, sac, amount }]
  lines    Json
  subtotal Decimal @db.Decimal(12, 2)
  cgst     Decimal @db.Decimal(12, 2)
  sgst     Decimal @db.Decimal(12, 2)
  igst     Decimal @db.Decimal(12, 2)
  total    Decimal @db.Decimal(12, 2)

  paidAt      DateTime?
  paymentMode String?
  paymentRef  String?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fy, serial])
  @@index([accountId, createdAt])
  @@index([status, dueAt])
}

/// Every change to what a clinic is entitled to, and whether it reached
/// the clinic. The answer to "when did they move to Hospital, and who
/// agreed it" a year later.
model PlanChange {
  id        String        @id @default(cuid())
  accountId String
  account   ClinicAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  fromPlan     PlanTier?
  toPlan       PlanTier
  fromFeatures String?
  toFeatures   String
  readOnly     Boolean @default(false)
  reason       String?
  actorName    String
  jobId        String?

  at DateTime @default(now())

  @@index([accountId, at])
}

/// What a deal looks like before the client has agreed to it.
///
/// Three documents move the money in this product: a quotation, then an
/// agreement, then invoices. The quotation is the one that costs us
/// nothing to change -- line items go up and down, discounts come and
/// go, the client is weighing whether to buy. The moment it is sent, it
/// is locked: an Edit sends a new Version instead, so an audit still
/// reads back what the client saw.
model Quotation {
  id        String          @id @default(cuid())
  accountId String?
  account   ClinicAccount?  @relation(fields: [accountId], references: [id], onDelete: SetNull)

  /// NAY/Q/FY/0001. Null while draft; given on issue, consecutive
  /// within the financial year so an auditor reads them as a series.
  number   String?          @unique
  fy       String?
  serial   Int?
  /// A new version on edit after send, so the sent copy survives.
  version  Int              @default(1)

  status   QuotationStatus  @default(DRAFT)
  /// Where in the sales pipeline this deal sits. Separate from status
  /// because a quote can be SENT but still be at NEGOTIATION, and the
  /// pipeline view the owner opens each morning is organised by stage.
  stage    PipelineStage    @default(NEW_LEAD)
  title    String
  planTier PlanTier         @default(BASIC)

  // ── Who it is addressed to. Copied at creation. ────────────────────
  clientName     String
  clientAddress  String?
  clientGSTIN    String?
  clientState    String?
  clientContact  String?
  clientEmail    String?
  clientPhone    String?

  // ── Who it is from. Copied for immutability. ──────────────────────
  providerName    String
  providerAddress String?
  providerGSTIN   String?
  providerState   String?

  validUntil DateTime?

  // ── Totals, computed from the line items and frozen on issue. ────
  subtotal       Decimal @db.Decimal(12, 2) @default(0)
  discountAmount Decimal @db.Decimal(12, 2) @default(0)
  taxableAmount  Decimal @db.Decimal(12, 2) @default(0)
  cgst           Decimal @db.Decimal(12, 2) @default(0)
  sgst           Decimal @db.Decimal(12, 2) @default(0)
  igst           Decimal @db.Decimal(12, 2) @default(0)
  total          Decimal @db.Decimal(12, 2) @default(0)
  currency       String  @default("INR")

  scope          String?
  exclusions     String?
  paymentTerms   String?
  deliveryTerms  String?
  internalNotes  String?
  summary        String?

  sentAt     DateTime?
  acceptedAt DateTime?
  rejectedAt DateTime?
  acceptedBy String?

  /// When the owner should next follow up, so the pipeline view opens
  /// each morning showing what is overdue rather than what is new.
  nextFollowUpAt DateTime?
  lastContactedAt DateTime?

  lineItems  QuotationLineItem[]
  activities QuotationActivity[]
  agreements Agreement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fy, serial, version])
  @@index([accountId, createdAt])
  @@index([status, validUntil])
  @@index([stage, nextFollowUpAt])
}

model QuotationLineItem {
  id          String                @id @default(cuid())
  quotationId String
  quotation   Quotation             @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  category    QuotationLineCategory
  description String
  unit        String
  quantity    Decimal               @db.Decimal(10, 2) @default(1)
  unitPrice   Decimal               @db.Decimal(12, 2)
  discount    Decimal               @db.Decimal(12, 2) @default(0)
  lineTotal   Decimal               @db.Decimal(12, 2) @default(0)
  sortOrder   Int                   @default(0)
  sac         String?

  @@index([quotationId, sortOrder])
}

/// A touch -- a call, an email, a meeting, a WhatsApp -- against a deal.
/// The funnel view groups these to answer "when did we last talk to
/// this clinic" so nobody gets forgotten between the ten they are open
/// with. Emails sent from the console write one of these automatically.
model QuotationActivity {
  id          String       @id @default(cuid())
  quotationId String
  quotation   Quotation    @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  kind        ActivityKind
  subject     String
  body        String?
  /// The owner's own notes after a call, the body of a sent email, or
  /// the text of a WhatsApp -- whatever is readable later.
  outcome     String?
  /// Who performed the action; the owner's login name.
  actor       String

  /// When the touch happened. For a scheduled follow-up this is the
  /// FUTURE; the UI shows what is due before what has been done.
  at          DateTime     @default(now())
  isScheduled Boolean      @default(false)
  completedAt DateTime?

  createdAt DateTime @default(now())

  @@index([quotationId, at])
  @@index([isScheduled, at])
}

/// The signed contract. One deal, one agreement, built from the
/// accepted quotation.
model Agreement {
  id            String          @id @default(cuid())
  accountId     String
  account       ClinicAccount   @relation(fields: [accountId], references: [id], onDelete: Restrict)
  quotationId   String?
  quotation     Quotation?      @relation(fields: [quotationId], references: [id], onDelete: SetNull)

  number        String?         @unique
  fy            String?
  serial        Int?

  status        AgreementStatus @default(DRAFT)
  title         String
  /// Clauses as [{ heading, paragraphs[] }]. The PDF and the HTML
  /// preview read from the same source.
  clauses       Json

  effectiveFrom DateTime?
  termMonths    Int             @default(12)
  noticeDays    Int             @default(60)
  autoRenew     Boolean         @default(true)

  clientName      String
  clientAddress   String?
  clientGSTIN     String?
  providerName    String
  providerAddress String?
  providerGSTIN   String?

  setupFee   Decimal?  @db.Decimal(12, 2)
  yearlyFee  Decimal?  @db.Decimal(12, 2)
  monthlyFee Decimal?  @db.Decimal(12, 2)
  currency   String    @default("INR")

  providerSignedBy   String?
  providerSignedAt   DateTime?
  clientSignedByName String?
  clientSignedByRole String?
  clientSignedAt     DateTime?
  clientSignatureRef String?

  issuedAt     DateTime?
  terminatedAt DateTime?
  terminationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fy, serial])
  @@index([accountId, createdAt])
  @@index([status, effectiveFrom])
}

// ── Subscriptions for every product (Growth now, clinics next) ─────────
//
// The console sells each product's plans as Razorpay subscriptions,
// monthly or yearly, and tells the product's server what the customer may
// use, over signed server-to-server calls (src/lib/s2s.ts). The product
// enforces it; the console bills. No product secret is stored here: a
// product's public key is enough to check its calls.

enum Product {
  CLINIC
  GROWTH
}

enum SubInterval {
  MONTH
  YEAR
}

enum SubStatus {
  CREATED       // made; the customer has not set up the payment yet
  AUTHENTICATED // payment set up; the first charge is on its way
  ACTIVE
  PENDING       // a renewal failed; Razorpay is retrying
  HALTED        // renewals stopped after failed retries
  CANCELLED
  COMPLETED
  EXPIRED
}

/// The console's own billing settings: one row.
model BillingSettings {
  id                String   @id @default("default")
  /// The yearly price is twelve months less this percentage, unless an
  /// offer sets its own. The founder types it; 0 until then.
  yearlyDiscountPct Decimal  @default(0) @db.Decimal(5, 2)
  updatedBy         String?
  updatedAt         DateTime @updatedAt
}

/// What a product sells: a plan, a single module, or a plan made for one
/// customer. Prices are a month, in paise; null is not on sale.
model CatalogOffer {
  id                String   @id
  product           Product
  /// The product's own name for it, e.g. "plan-10k".
  code              String
  kind              String   // plan | module | custom
  name              String
  summary           String   @default("")
  includes          String[] @default([])
  /// What the product opens for it. Growth: { modules, videosMonth, aiSecondsMonth }.
  grants            Json
  monthlyPricePaise Int?
  yearlyDiscountPct Decimal? @db.Decimal(5, 2)
  published         Boolean  @default(false)
  /// A custom offer is for one customer of the product only.
  accountRef        String?
  accountName       String?
  position          Int      @default(0)
  updatedBy         String?
  updatedAt         DateTime @updatedAt

  @@unique([product, code])
}

/// Razorpay plans already made, so the same price and interval reuse one.
model RazorpayPlan {
  id          String      @id // Razorpay's plan_...
  interval    SubInterval
  amountPaise Int
  name        String
  createdAt   DateTime    @default(now())

  @@unique([interval, amountPaise, name])
}

model Subscription {
  id                     String      @id @default(cuid())
  product                Product
  /// The customer in the product: a Growth business id, or a clinic account id.
  accountRef             String
  accountName            String
  offerCodes             String[]
  offerNames             String[]
  /// What each offer opened when bought, so a later catalogue edit changes nothing paid for.
  grants                 Json
  interval               SubInterval
  /// Charged each cycle, in paise.
  amountPaise            Int
  razorpayPlanId         String?
  razorpaySubscriptionId String?     @unique
  shortUrl               String?
  /// test: paid on the product's stand-in checkout, renewed by the console; no money moves.
  test                   Boolean     @default(false)
  status                 SubStatus   @default(CREATED)
  currentStart           DateTime?
  currentEnd             DateTime?
  cancelAtEnd            Boolean     @default(false)
  /// A switch to another plan starts when the one it replaces ends.
  startsAt               DateTime?
  replacesId             String?
  createdBy              String
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  charges SubscriptionCharge[]

  @@index([product, accountRef])
}

/// One paid cycle, and whether the product has been told.
model SubscriptionCharge {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  /// Razorpay's pay_...; null for a test charge.
  paymentId      String?      @unique
  amountPaise    Int
  periodStart    DateTime
  periodEnd      DateTime
  pushedAt       DateTime?
  pushError      String?
  createdAt      DateTime     @default(now())

  @@index([pushedAt])
}
