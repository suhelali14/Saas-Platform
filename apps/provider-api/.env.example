# ── Provider console API ────────────────────────────────────────────────
# This service runs the VENDOR's console, not a clinic's. It manages many
# clinics; it never touches any clinic's patient data.

PORT=4200
DATABASE_URL="postgresql://user:pass@host/provider_console?schema=provider"
JWT_SECRET="generate-a-long-random-string"

# First console account, created by `npm run seed`.
PROVIDER_SEED_EMAIL=you@example.com
PROVIDER_SEED_PASSWORD=change-me-now-12345
PROVIDER_SEED_NAME="Your Name"

# ── Provisioning (optional) ─────────────────────────────────────────────
# Without these the console runs in DRY RUN: every provisioning step shows
# exactly what it would call, and calls nothing. Add them to go live.
#
# IMPORTANT: the console deliberately does NOT store each clinic's database
# password. It stores the Neon project id and fetches the connection string
# from Neon when it needs one. That way a breach of this console is one
# credential to rotate, not every clinic's PHI at once.

# NEON_API_KEY=
# NEON_ORG_ID=

# VERCEL_TOKEN=
# VERCEL_TEAM_ID=

# Git repo the clinic apps deploy from.
# DEPLOY_REPO=suhelali14/clinic
