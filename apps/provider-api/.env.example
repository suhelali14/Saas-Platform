# ── Provider console API ────────────────────────────────────────────────
# This service runs the VENDOR's console, not a clinic's. It manages many
# clinics; it never touches any clinic's patient data.

PORT=4200
DATABASE_URL="postgresql://user:pass@host/provider_console?schema=provider"
JWT_SECRET="generate-a-long-random-string"

# First console account, created by `npm run seed`.
PROVIDER_SEED_EMAIL=you@example.com
PROVIDER_SEED_PASSWORD=change-me-now-12345
PROVIDER_SEED_NAME="Your Name"

# ── Provisioning (optional) ─────────────────────────────────────────────
# Without these the console runs in DRY RUN: every provisioning step shows
# exactly what it would call, and calls nothing. Add them to go live.
#
# IMPORTANT: the console deliberately does NOT store each clinic's database
# password. It stores the Neon project id and fetches the connection string
# from Neon when it needs one. That way a breach of this console is one
# credential to rotate, not every clinic's PHI at once.

# NEON_API_KEY=
# NEON_ORG_ID=

# VERCEL_TOKEN=
# VERCEL_TEAM_ID=

# Git repo the clinic apps deploy from.
# DEPLOY_REPO=suhelali14/clinic

# ── Platform subdomain addressing ─────────────────────────────────────
# The domain every clinic subdomain hangs off. Used to build the
# hostnames shown in the console, and to let any clinic subdomain reach
# the tenant directory through CORS (the list of clinics is unbounded,
# so it is matched by suffix rather than enumerated).
PLATFORM_DOMAIN=yourco.in

# OPTIONAL, and usually left unset. Each clinic's API is its own
# deployment, so one wildcard cannot address them all -- normally you
# let the host assign the hostname (acme-api.up.railway.app) and record
# it as the account's apiDomain, which always wins over this template
# and needs no DNS. Set this only if you want vanity API hostnames and
# accept adding a DNS record per clinic.
# CLINIC_API_URL_TEMPLATE=https://{slug}.api.yourco.in/api/clinic

# NOTE for the deployed server: do NOT wrap values in quotes in
# /srv/clinic/env/*.env. Those files are read by `docker --env-file`,
# which keeps the quotes as part of the value. (Quotes are fine here in
# a local .env read by dotenv.)
