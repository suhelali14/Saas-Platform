# ── Provider console API ────────────────────────────────────────────────
# This service runs the VENDOR's console, not a clinic's. It manages many
# clinics; it never touches any clinic's patient data.

PORT=4200
DATABASE_URL="postgresql://user:pass@host/provider_console?schema=provider"
JWT_SECRET="generate-a-long-random-string"

# First console account, created by `npm run seed`.
PROVIDER_SEED_EMAIL=you@example.com
PROVIDER_SEED_PASSWORD=change-me-now-12345
PROVIDER_SEED_NAME="Your Name"

# ── Provisioning (optional) ─────────────────────────────────────────────
# Without these the console runs in DRY RUN: every provisioning step shows
# exactly what it would call, and calls nothing. Add them to go live.
#
# IMPORTANT: the console deliberately does NOT store each clinic's database
# password. It stores the Neon project id and fetches the connection string
# from Neon when it needs one. That way a breach of this console is one
# credential to rotate, not every clinic's PHI at once.

# NEON_API_KEY=
# NEON_ORG_ID=

# VERCEL_TOKEN=
# VERCEL_TEAM_ID=

# Git repo the clinic apps deploy from.
# DEPLOY_REPO=suhelali14/clinic

# ── Platform subdomain addressing ─────────────────────────────────────
# The domain every clinic subdomain hangs off. Used to build the
# hostnames shown in the console, and to let any clinic subdomain reach
# the tenant directory through CORS (the list of clinics is unbounded,
# so it is matched by suffix rather than enumerated).
PLATFORM_DOMAIN=yourco.in

# OPTIONAL, and usually left unset. Each clinic's API is its own
# deployment, so one wildcard cannot address them all -- normally you
# let the host assign the hostname (acme-api.up.railway.app) and record
# it as the account's apiDomain, which always wins over this template
# and needs no DNS. Set this only if you want vanity API hostnames and
# accept adding a DNS record per clinic.
# CLINIC_API_URL_TEMPLATE=https://{slug}.api.yourco.in/api/clinic

# Inline provisioning. The usual flow queues a job for a host-side
# runner (deploy/clinic-runner.sh via systemd). That stays correct for
# a production server -- it keeps the Docker socket off this container
# -- but it is also the one thing that can leave the console saying
# "Queued" forever on a machine where the runner is not installed.
#
# Setting this to 1 switches the provision-clinic endpoint to running
# in this process and marking the clinic LIVE at once, so "one click"
# in the console really is one click. For local dev, demo laptops, and
# small single-server deployments where the clinic APIs are managed
# elsewhere (they come up from docker-compose, systemd, a cloud host).
# The runner, when present, is still the safer path.
# PROVIDER_INLINE_PROVISION=0

# NOTE for the deployed server: do NOT wrap values in quotes in
# /srv/clinic/env/*.env. Those files are read by `docker --env-file`,
# which keeps the quotes as part of the value. (Quotes are fine here in
# a local .env read by dotenv.)

# Where clinic databases are created. Region availability differs by
# Neon organisation -- aws-Singapore (aws-ap-southeast-1) is not enabled for every
# account, and Neon answers 404 without naming the problem. Check the
# region of an existing project if unsure.
NEON_REGION=aws-ap-southeast-1

# ── Transactional email (optional) ─────────────────────────────────────
# Sends a welcome message to the clinic owner when a new account is
# provisioned: URLs, login email, one-time password. Without the two
# below set, provisioning still succeeds -- the email is a no-op and a
# [email] skipped line goes to the log.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# MAIL_FROM=Nayaversse <no-reply@nayaversse.in>
# FOUNDER_CC_EMAIL=suhelalipakjade@gmail.com

# ── Subscriptions for every product (Growth now, clinics next) ──
# off: nothing sold. test: products' stand-in checkout, renewals by the console,
# no money moves. razorpay: real monthly or yearly Razorpay subscriptions.
SUBSCRIPTIONS_MODE=off
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay dashboard -> Webhooks: https://api.nayaverse.in/api/provider/webhooks/razorpay,
# the subscription.* events, and this secret.
RAZORPAY_WEBHOOK_SECRET=
SUBSCRIPTION_GRACE_DAYS=2

# ── Server-to-server (src/lib/s2s.ts) ──
# node scripts/s2s-keygen.mjs: this console's private key here, its public key to each product.
CONSOLE_SIGNING_KEY=
# Nayaverse Growth: its address and its public key.
GROWTH_URL=
GROWTH_PUBLIC_KEY=
