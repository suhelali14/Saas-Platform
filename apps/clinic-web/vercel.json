{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path((?!assets/).*)",
      "has": [{ "type": "host", "value": "(?<slug>[^.]+).portal.nayaverse.in" }],
      "destination": "https://:slug.portal.nayaversse.in/:path",
      "permanent": false
    },
    {
      "source": "/:path((?!assets/).*)",
      "has": [{ "type": "host", "value": "(?<slug>[^.]+).nayaverse.in" }],
      "destination": "https://:slug.nayaversse.in/:path",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/robots.txt", "destination": "/api/robots" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/", "destination": "/api/page" },
    { "source": "/blog", "destination": "/api/page" },
    { "source": "/blog/:slug", "destination": "/api/page" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ]
}
