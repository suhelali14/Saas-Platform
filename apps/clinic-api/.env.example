# Clinic Management System API -- one deployment per clinic client.
# Onboarding a new clinic = a new database + a fresh copy of this file, never
# a code change. See the plan's "New-clinic onboarding runbook".

PORT=4100
NODE_ENV=development

# Point this at a dedicated database for THIS clinic only -- never share one
# database across multiple clinics. For local dev, reuse the repo-root
# docker-compose Postgres with a clinic-specific database name:
#   docker exec -it <postgres-container> psql -U intently -c "CREATE DATABASE clinic_yourclinicname;"
DATABASE_URL="postgresql://intently:intently@localhost:5432/clinic_dev"

# Generate a unique secret per clinic deployment: openssl rand -hex 32
JWT_SECRET=dev-only-change-me-before-anything-beyond-local-use

# Where live sessions are kept. A sign-in creates a row here and the token
# only points at it, which is what makes access revocable: deactivating a
# staff member ends their session on the next request rather than leaving
# them full patient access until the token expires.
#
# In production each clinic gets its own Redis on its own docker network
# (deploy/render-compose.sh). Locally, one on the default port is fine:
#   docker run -d --name clinic-redis -p 6379:6379 redis:7-alpine
REDIS_URL=redis://127.0.0.1:6379

# Gates which modules are active for this clinic's plan tier -- see
# src/config/features.ts. BASIC | STANDARD | PREMIUM.
CLINIC_PLAN=BASIC

# One-time seed values for prisma/seed-clinic.ts (creates the clinic's
# branding row + first DOCTOR/ADMIN login). Not read at runtime otherwise.
CLINIC_SEED_NAME="Demo Clinic"
CLINIC_SEED_DOCTOR_NAME="Dr. Demo"
CLINIC_SEED_EMAIL=doctor@clinic.local
CLINIC_SEED_PASSWORD=change-me-now-12345

# ── Translation (Phase 9) ───────────────────────────────────────────────
# All optional. With none of this set, the translation editor still works
# fully by hand and the public site still serves whatever translations
# exist -- only the "auto-translate" button needs a provider.

# Master switch. Set false to turn auto-translation off entirely for this
# clinic even when a key is present (e.g. a plan that doesn't include it,
# or to stop spending). Hand-entered translations are unaffected.
# AI_TRANSLATION_ENABLED=true

# Which provider to use. "auto" picks Anthropic if its key is set,
# otherwise Gemini.
# TRANSLATION_PROVIDER=auto

# Supply whichever you have. Never commit real keys.
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Model names, overridable so a deployment can move to a newer model
# without a code change.
# ANTHROPIC_TRANSLATION_MODEL=claude-sonnet-5
# GEMINI_TRANSLATION_MODEL=gemini-2.5-flash

# Which content classes may be auto-translated.
#   clinic = site copy (tagline, services, FAQs) -- short and cheap
#   post   = blog articles -- long, and the bulk of any cost
# Set to "clinic" alone to auto-translate the site but never the articles.
# AI_TRANSLATABLE_NAMESPACES=clinic,post

# Cost guard: most items one translate run may send. A run over this is
# refused with a message, never silently truncated.
# AI_TRANSLATION_MAX_ITEMS=200

# NOTE for the deployed server: do NOT wrap values in quotes in
# /srv/clinic/env/*.env. Those files are read by `docker --env-file`,
# which keeps the quotes as part of the value. (Quotes are fine here in
# a local .env read by dotenv.)
