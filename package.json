{
  "name": "intently",
  "private": true,
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "npm run dev -w apps/api",
    "dev:dashboard": "npm run dev -w apps/business-dashboard",
    "dev:mobile": "npm run start -w apps/mobile",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^6.0.0"
  }
}
